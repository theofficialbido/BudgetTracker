                android:value="expense" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="add_income"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_add"
        android:shortcutLongLabel="@string/shortcut_income_long"
