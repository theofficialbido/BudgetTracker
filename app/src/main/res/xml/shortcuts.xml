        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="com.bido.budgetsync.MainActivity"
            android:targetPackage="com.bido.budgetsync">
            <extra
                android:name="open"
                android:value="income" />
        </intent>
    </shortcut>
</shortcuts>
